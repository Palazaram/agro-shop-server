{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "agro-shop-api",
    "Audience": "agro-shop-client",
    "AccessTokenExpirationMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 30,
    "RetentionDaysAfterExpiry": 30
  }
}
