{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "agro-shop-api",
    "Audience": "agro-shop-client",
    "AccessTokenExpirationMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 30,
    "RetentionDaysAfterExpiry": 30
  }
}
